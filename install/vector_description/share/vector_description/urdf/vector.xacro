<?xml version="1.0" ?>
<robot name="vector" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Define xacro property for ros2_controllers config file path -->
<!-- This allows the launch file to pass in the correct absolute path for Gazebo Harmonic -->
<xacro:arg name="ros2_controllers_config" default="config/industrial_robot_ros2_controllers.yaml" />

<xacro:include filename="$(find vector_description)/urdf/materials.xacro" />
