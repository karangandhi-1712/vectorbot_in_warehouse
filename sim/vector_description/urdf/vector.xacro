<joint name="slider_z_axis" type="prismatic">
  <origin xyz="0.131878 0.005317 1.244" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="slider_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <!-- effort raised from 100→2000 to match PID max_effort.
       Old value of 100 was barely above gravity (78N), leaving no margin.
       damping=500 prevents instant free-fall during the 5s controller startup. -->
  <limit upper="0.4" lower="-0.6" effort="2000" velocity="100"/>
  <dynamics damping="50.0" friction="10.0"/>
</joint>

<joint name="torso_with_slider" type="fixed">
  <origin xyz="0.018122 -0.005317 -0.252573" rpy="0 0 0"/>
  <parent link="slider_1"/>
  <child link="torso_1"/>
</joint>

<joint name="left_shoulder_holder" type="revolute">
  <origin xyz="0.06143 0.13 0.071815" rpy="0 0 0"/>
  <parent link="torso_1"/>
  <child link="left_arm_link_1_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
  <limit upper="-3.110" lower="1.000" effort="100" velocity="100"/>
  <dynamics damping="10.0" friction="5.0"/>
</joint>

<joint name="left_shoulder" type="revolute">
  <origin xyz="-0.02315 0.061 0.0" rpy="0 0 0"/>
