<?xml version="1.0" ?>
<robot name="vector" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Define xacro property for ros2_controllers config file path -->
<!-- This allows the launch file to pass in the correct absolute path for Gazebo Harmonic -->
<xacro:arg name="ros2_controllers_config" default="config/industrial_robot_ros2_controllers.yaml" />

<xacro:include filename="$(find vector_description)/urdf/materials.xacro" />
<xacro:include filename="$(find vector_description)/urdf/vector.trans" />
<xacro:include filename="$(find vector_description)/urdf/vector.gazebo" />
<xacro:include filename="$(find vector_description)/urdf/vector.ros2_control.xacro" />
<link name="base_link">
  <!-- SIM-TUNED: Light base (5 kg) at z=0.  Upper-body links are set to
       near-zero mass (0.01 kg each) so gravity exerts almost no torque on
       the top-heavy structure.  No collision on base_link — only wheels
       and casters touch the ground. -->
  <inertial>
    <origin xyz="0.0 0.0 -0.5" rpy="0 0 0"/>
    <mass value="100.0"/>
    <inertia ixx="1.0" iyy="1.0" izz="0.5" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find vector_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="white"/>
  </visual>
  <!-- No body collision box — only wheels and casters should touch the ground.
       A body box would scrape the ground during turns and cause wobble. -->
  <collision name="rear_caster_collision">
    <origin xyz="-0.18 0.0 0.0195" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.02"/>
    </geometry>
  </collision>
  <collision name="front_caster_collision">
    <origin xyz="0.18 0.0 0.0195" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.02"/>
    </geometry>
  </collision>
  <visual name="rear_caster_visual">
    <origin xyz="-0.18 0.0 0.0175" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.02"/>
    </geometry>
    <material name="dark_grey"/>
  </visual>
  <visual name="front_caster_visual">
    <origin xyz="0.18 0.0 0.0175" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.02"/>
    </geometry>
    <material name="dark_grey"/>
  </visual>
</link>

<link name="slider_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" iyz="0" ixz="0"/>
